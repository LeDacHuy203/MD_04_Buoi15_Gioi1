{
  "info": {
    "name": "Buoi 15 - Identity, Gateway & RBAC Resource Server",
    "description": "Collection kiểm thử đầy đủ Bài 1, Bài 2 và Bài 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Bài 1 - Identity Service (Cổng 8080)",
      "item": [
        {
          "name": "1. Login - Sinh viên (STUDENT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "2. Login - Giảng viên (INSTRUCTOR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"instructor1\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "3. Refresh Token - Cấp Access Token mới",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"b60e23d1-cec8-46a1-9253-ffe5335f1287\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/refresh",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "refresh"]
            }
          }
        }
      ]
    },
    {
      "name": "Bài 2 - API Gateway Trạm gác (Cổng 8888)",
      "item": [
        {
          "name": "1. GET Courses KHÔNG token -> Chặn 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8888/api/courses",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "2. GET Courses Token HẾT HẠN -> Chặn 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJzdHVkZW50MSIsInJvbGUiOiJTVFVERU5UIiwiZXhwIjoxNjAwMDAwMDAwfQ.invalid_or_expired"
              }
            ],
            "url": {
              "raw": "http://localhost:8888/api/courses",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["api", "courses"]
            }
          }
        }
      ]
    },
    {
      "name": "Bài 3 - Phân quyền RBAC Course Server (Cổng 8888 qua Gateway)",
      "item": [
        {
          "name": "1. POST Course với STUDENT Token -> Bị chặn 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{STUDENT_TOKEN}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Khóa học thử nghiệm bởi Student\",\n  \"instructor\": \"Sinh viên\"\n}"
            },
            "url": {
              "raw": "http://localhost:8888/api/courses",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "2. POST Course với INSTRUCTOR Token -> Cho phép 201 Created",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{INSTRUCTOR_TOKEN}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Thiết kế hệ thống Microservices & RBAC\",\n  \"instructor\": \"Giảng viên chính\"\n}"
            },
            "url": {
              "raw": "http://localhost:8888/api/courses",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "3. GET Courses với STUDENT Token -> 200 OK",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{STUDENT_TOKEN}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8888/api/courses",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "4. GET Courses với INSTRUCTOR Token -> 200 OK",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{INSTRUCTOR_TOKEN}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8888/api/courses",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["api", "courses"]
            }
          }
        }
      ]
    }
  ]
}
